{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw test)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw clean package)",
      "Bash(.\\mvnw.cmd test)",
      "Bash(.\\mvnw.cmd test *)",
      "Bash(.\\mvnw.cmd clean package)",
      "Bash(docker ps *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}