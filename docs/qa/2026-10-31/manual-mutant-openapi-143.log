    "/triages/{id}": {
      "get": {
        "description": "Recorded in the audit trail (TRIAGE_VIEWED) with the reader's role, every time it is read",
        "operationId": "findTriage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageReadResponseDTO"
                }
              }
            },
            "description": "The triage"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not an admin or psychologist"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "No triage with this id (TRIAGE_NOT_FOUND)"
          },
          "500": {
            "content": {
