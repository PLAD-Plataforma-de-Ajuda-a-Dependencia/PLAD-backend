          "total_elements",
          "total_pages"
        ]
      },
      "PageResponseDTOTriageReadResponseDTO": {
        "description": "One page of results",
        "properties": {
          "items": {
            "description": "Items of this page",
            "items": {
              "$ref": "#/components/schemas/TriageReadResponseDTO"
            },
            "type": "array"
          },
          "page": {
            "description": "Zero-based page number",
            "example": 0,
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "description": "Requested page size",
            "example": 20,
            "format": "int32",
            "type": "integer"
          },
          "total_elements": {
            "description": "Total items across all pages",
            "example": 42,
            "format": "int64",
            "type": "integer"
          },
          "total_pages": {
            "description": "Total number of pages",
            "example": 3,
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total_elements",
          "total_pages"
        ]
      },
      "QuestionResponseDTO": {
        "properties": {
          "code": {
            "description": "Stable question code, the same in every environment",
            "example": "AGE_RANGE",
            "type": "string"
          },
          "display_order": {
            "description": "Position in the questionnaire, ascending",
            "example": 1,
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "description": "Question id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "options": {
            "description": "Selectable options; empty for free_text",
            "items": {
              "$ref": "#/components/schemas/OptionDTO"
            },
            "type": "array"
          },
          "question_text": {
            "description": "Question text",
            "example": "What is your age range?",
            "type": "string"
          },
          "question_type": {
            "description": "single_choice takes one option, multi_choice several, free_text a text",
            "enum": [
              "single_choice",
              "multi_choice",
              "free_text"
            ],
            "type": "string"
          },
          "required": {
            "description": "Whether the question must be answered",
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "display_order",
          "id",
          "options",
          "question_text",
          "question_type",
          "required"
        ]
      },
      "RegisterRequestDTO": {
        "properties": {
          "birth_date": {
            "description": "Date of birth (yyyy-MM-dd). The platform is only for adults: the person must be at least 18 years old on today's date in America/Sao_Paulo, turning 18 on the same day and month of birth (born on Feb 29: Mar 1 in non-leap years), and at most 120. Otherwise 400 VALIDATION_ERROR on birth_date",
            "example": "1990-05-20",
            "format": "date",
            "type": "string"
          },
          "credential_type": {
            "description": "Professional council; required when type_user is psicologo",
            "enum": [
              "CRM",
              "CRP"
            ],
            "example": "CRP",
            "type": "string"
          },
          "crm_crp_number": {
            "description": "Council registration number, unique; required when type_user is psicologo",
            "example": "06/123456",
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "description": "Login e-mail; stored lowercased and unique",
            "example": "maria@example.com",
            "format": "email",
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "enum": [
              "masculino",
              "feminino",
              "nao_binario",
              "transexual",
              "outro"
            ],
            "type": "string"
          },
          "graduate": {
            "description": "Graduation, only stored for psicologo",
            "example": "Psicologia - USP",
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "description": "At least 8 characters and at most 72 bytes in UTF-8",
            "example": "senha-segura-123",
            "maxLength": 2147483647,
            "minLength": 8,
            "type": "string"
          },
          "real_name": {
            "description": "Full name",
            "example": "Maria Silva",
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "type_user": {
            "description": "Account type; psicologo also requires credential_type and crm_crp_number. admin is never accepted here (400 INVALID_REGISTRATION): the first admin is created at startup",
            "enum": [
              "dependente",
              "psicologo",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "birth_date",
          "email",
          "gender",
          "password",
          "real_name",
          "type_user"
        ]
      },
      "TriageReadResponseDTO": {
        "description": "A triage as read by an admin or psychologist; the dependent is identified by id only",
        "properties": {
          "answers": {
            "description": "Stored answers, one entry per question",
            "items": {
              "$ref": "#/components/schemas/AnswerResponseDTO"
            },
            "type": "array"
          },
          "created_at": {
            "description": "When the triage was first submitted (UTC)",
            "example": "2026-10-27T21:15:30Z",
            "format": "date-time",
            "type": "string"
          },
          "dependent_id": {
            "description": "User id of the dependent who answered; no name or e-mail",
            "example": 7,
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "Triage id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "answers",
          "created_at",
          "dependent_id",
          "id"
        ]
      },
      "TriageRequestDTO": {
        "properties": {
          "answers": {
            "description": "One entry per answered question; every question is optional and can be answered at most once",
            "items": {
              "$ref": "#/components/schemas/AnswerRequestDTO"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "answers"
        ]
      },
      "TriageResponseDTO": {
        "properties": {
          "answers": {
            "description": "Stored answers, one entry per question",
            "items": {
              "$ref": "#/components/schemas/AnswerResponseDTO"
            },
            "type": "array"
          },
          "created_at": {
            "description": "When the triage was first submitted (UTC)",
            "example": "2026-10-27T21:15:30Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Triage id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "answers",
          "created_at",
          "id"
        ]
      },
      "UserResponseDTO": {
        "properties": {
          "email": {
            "description": "Normalized (lowercase) e-mail",
            "example": "maria@example.com",
            "type": "string"
          },
          "id": {
            "description": "User id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "real_name": {
            "description": "Full name",
            "example": "Maria Silva",
            "type": "string"
          }
        },
        "required": [
          "email",
          "id",
          "real_name"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Backend of the Plataforma de Ajuda a Dependência. JSON fields are snake_case. Every error, including a missing or invalid token (401), uses ErrorResponseDTO.",
    "title": "PLAD API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/audit": {
      "get": {
        "description": "Entries hold only ids and state changes, never answers, names, e-mails or free text",
        "operationId": "list",
        "parameters": [
          {
            "description": "Only entries about this user",
            "in": "query",
            "name": "subject_user_id",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Only this action",
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "enum": [
                "TRIAGE_SUBMITTED",
                "TRIAGE_RESUBMITTED",
                "TRIAGE_VIEWED"
              ],
              "type": "string"
            }
          },
          {
            "description": "Zero-based page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size, 1 to 100",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseDTOAuditLogResponseDTO"
                }
              }
            },
            "description": "One page of audit entries"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Unknown action or invalid page/size"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not an admin"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "List audit entries, newest first",
        "tags": [
          "Audit"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDTO"
                }
              }
            },
            "description": "Logged in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid e-mail or password"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Too many attempts, per client IP or per e-mail",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [ ],
        "summary": "Log in and get a JWT",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDTO"
                }
              }
            },
            "description": "User created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid body (including a birth date under 18 years old), type_user admin, or a psychologist without credentials or with a credential number already registered"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "E-mail already in use"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [ ],
        "summary": "Register a dependent or a psychologist",
        "tags": [
          "Auth"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Data of the logged-in user, for the front to pick the first screen after login. The user comes from the token, never from the request. Fields that do not apply to the user's type are null: has_triage for dependents; real_name, credential_type, crm_crp_number and is_validated for psychologists",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDTO"
                }
              }
            },
            "description": "The user's own data"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token, or the user no longer exists"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "My account",
        "tags": [
          "Me"
        ]
      }
    },
    "/me/access-log": {
      "get": {
        "description": "Transparency to the data subject (LGPD art. 18). Shows the role of who read, never their name. Newest first",
        "operationId": "accessLog",
        "parameters": [
          {
            "description": "Zero-based page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size, 1 to 100",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseDTOAccessLogEntryDTO"
                }
              }
            },
            "description": "One page of access entries"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid page/size"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not a dependent"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "When someone else read my triage, and in which role",
        "tags": [
          "Me"
        ]
      }
    },
    "/triage": {
      "post": {
        "description": "Every question is optional. A dependent can submit once; use PUT to change it afterwards. With no answers nothing is stored, so the dependent can still submit later",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponseDTO"
                }
              }
            },
            "description": "Triage stored"
          },
          "204": {
            "description": "No question answered, nothing stored"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid body, answer without question_id or question_code (or with ones that disagree), unknown or repeated question or invalid option"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not a dependent"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Triage already submitted"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Submit the triage",
        "tags": [
          "Triage"
        ]
      },
      "put": {
        "operationId": "resubmit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponseDTO"
                }
              }
            },
            "description": "Triage replaced"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid body, no answers, answer without question_id or question_code (or with ones that disagree), unknown or repeated question or invalid option"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not a dependent"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "No triage submitted yet"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Replace the submitted triage",
        "tags": [
          "Triage"
        ]
      }
    },
    "/triage/questions": {
      "get": {
        "operationId": "getQuestions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QuestionResponseDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Questions"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
