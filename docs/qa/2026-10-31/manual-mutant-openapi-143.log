        "properties": {
          "answers": {
            "description": "One entry per answered question; every question is optional and can be answered at most once",
            "items": {
              "$ref": "#/components/schemas/AnswerRequestDTO"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "answers"
        ]
      },
      "TriageResponseDTO": {
        "properties": {
          "answers": {
            "description": "Stored answers, one entry per question",
            "items": {
              "$ref": "#/components/schemas/AnswerResponseDTO"
            },
            "type": "array"
          },
          "created_at": {
            "description": "When the triage was first submitted (UTC)",
            "example": "2026-10-27T21:15:30Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Triage id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "answers",
          "created_at",
          "id"
        ]
      },
      "UserResponseDTO": {
        "properties": {
          "email": {
            "description": "Normalized (lowercase) e-mail",
            "example": "maria@example.com",
            "type": "string"
          },
          "id": {
            "description": "User id",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "real_name": {
            "description": "Full name",
            "example": "Maria Silva",
            "type": "string"
          }
        },
        "required": [
          "email",
          "id",
          "real_name"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Backend of the Plataforma de Ajuda a Dependência. JSON fields are snake_case. Every error, including a missing or invalid token (401), uses ErrorResponseDTO.",
    "title": "PLAD API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/audit": {
      "get": {
        "description": "Entries hold only ids and state changes, never answers, names, e-mails or free text",
        "operationId": "list",
        "parameters": [
          {
            "description": "Only entries about this user",
            "in": "query",
            "name": "subject_user_id",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Only this action",
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "enum": [
                "TRIAGE_SUBMITTED",
                "TRIAGE_RESUBMITTED",
                "TRIAGE_VIEWED"
              ],
              "type": "string"
            }
          },
          {
            "description": "Zero-based page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size, 1 to 100",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseDTOAuditLogResponseDTO"
                }
              }
            },
            "description": "One page of audit entries"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Unknown action or invalid page/size"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "The user is not an admin"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "List audit entries, newest first",
        "tags": [
          "Audit"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDTO"
                }
              }
            },
            "description": "Logged in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Invalid e-mail or password"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Too many attempts, per client IP or per e-mail",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "type": "integer"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTO"
                }
              }
            },
            "description": "Database unavailable, try again after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the next attempt",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [ ],
        "summary": "Log in and get a JWT",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
